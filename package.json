{
  "name": "trackbus",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "security": "node scripts/security-check.mjs",
    "format": "prettier --write apps packages db tests docs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "predev": "node scripts/prepare-assets.mjs",
    "db:migrate:local": "node scripts/migrate-local.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.16",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "7.18.5",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261103.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.1",
    "eslint": "10.14.0",
    "json-rpc-2.0": "1.7.1",
    "prettier": "3.6.2",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vinext": "1.4.2",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.156.1"
  },
  "type": "module",
  "overrides": {
    "sharp": "0.35.5",
    "esbuild": "0.28.1",
    "source-map-js": "1.2.2",
    "brace-expansion@^1": "1.1.21",
    "brace-expansion@>=3": "5.0.12",
    "js-yaml@^4": "4.3.2",
    "fflate@^0.7": "0.7.5",
    "fast-uri@^3": "3.1.9",
    "minimatch": "11.0.4"
  }
}
