{
  "expo": {
    "name": "TrackBus Driver",
    "slug": "trackbus-driver",
    "version": "7.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "tech.isee.trackbus.driver",
      "supportsTablet": false
    },
    "android": {
      "versionCode": 9,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "package": "tech.isee.trackbus.driver",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#090909"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O TrackBus Driver transmite sua posição apenas quando você inicia o GPS de uma viagem atribuída.",
          "locationWhenInUsePermission": "Permita localização para transmitir sua posição durante a viagem.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090909",
          "image": "./assets/icon.png",
          "imageWidth": 220
        }
      ]
    ]
  }
}
