{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trackbus-demonstracao",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/entrar"],
  },
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackbus-demo",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "vars": {
    "AUTH_PROVIDER": "cloudflare-access",
    "ACCESS_TEAM_DOMAIN": "CONFIGURAR.cloudflareaccess.com",
    "ACCESS_AUD": "CONFIGURAR_AUDIENCE_ACCESS",
    "INITIAL_ADMIN_EMAIL": "CONFIGURAR_EMAIL_ADMIN",
  },
}
