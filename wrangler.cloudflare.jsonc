{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trackbus-demonstracao",
  "account_id": "57f51b8f2cf73c9ba056464f864f233f",
  "main": "dist/server/index.js",
  "no_bundle": true,
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/entrar"],
  },
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trackbus-demo",
      "database_id": "9d5746f5-81f9-4878-9984-3765e60cca8c",
      "migrations_dir": "drizzle",
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "MAP_PROVIDER": "google",
    "GOOGLE_MAPS_MODE": "demo",
    "GOOGLE_MAPS_MAP_ID": "DEMO_MAP_ID",
    "AUTH_PROVIDER": "cloudflare-access",
    "ACCESS_TEAM_DOMAIN": "round-limit-693e.cloudflareaccess.com",
    "ACCESS_AUD": "95df41d8f7b10e7196a7f309c3cf922c20162e797793d0163322793f15844dbc",
    "INITIAL_ADMIN_EMAIL": "goldensla6@gmail.com",
  },
}
